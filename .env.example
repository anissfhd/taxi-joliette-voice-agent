# ---- Serveur ----
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Domaine public qui pointe vers ton VPS Hostinger.
# Sert à construire l'URL wss:// donnée à ConversationRelay ET à valider la signature Twilio.
PUBLIC_HOSTNAME=voice.tondomaine.com

# ---- OpenAI ----
OPENAI_API_KEY=sk-remplace-moi
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_MS=20000

# ---- n8n ----
# Les URLs de PRODUCTION (pas /webhook-test/), workflow activé.
N8N_COURSE_WEBHOOK_URL=https://n8n.example.com/webhook/<workflow-uuid>/taxi/course
N8N_LOG_WEBHOOK_URL=https://n8n.example.com/webhook/<workflow-uuid>/taxi/log
N8N_TIMEOUT_MS=8000
N8N_MAX_RETRIES=2

# ---- Twilio ----
TWILIO_AUTH_TOKEN=remplace-moi
VALIDATE_TWILIO_SIGNATURE=true

# ---- Voix ----
TTS_PROVIDER=ElevenLabs
TTS_VOICE=g6xIsTj2HwM6VR4iXFCw
TRANSCRIPTION_PROVIDER=Deepgram
SPEECH_MODEL=nova-3-general
DEFAULT_LANGUAGE=fr-CA
WELCOME_GREETING=Taxi Joliette, bonjour. Je peux prendre votre réservation. D'où partez-vous ?

# ---- Sessions ----
SESSION_MAX_AGE_MS=1800000
MAX_HISTORY_MESSAGES=40
