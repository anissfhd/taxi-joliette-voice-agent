{
  "name": "taxi-joliette-voice-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Voice Bridge entre Twilio ConversationRelay et OpenAI, avec appels outils vers n8n",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "twilio": "^5.4.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
